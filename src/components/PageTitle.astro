---
// Starlight page-title override, with a breadcrumb above it.
//
// The sidebar already shows where you are. A breadcrumb also shows it to
// someone who arrived from a search engine with the sidebar collapsed on a
// phone, which is most people who arrive worried.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { entry, sidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SECTIONS: Record<string, string> = {
  start: 'Start here',
  concepts: 'How it works',
  tasks: 'Everyday tasks',
  assets: 'Assets and protocols',
  safety: 'Safety',
  reference: 'Reference',
  developers: 'Developers',
  help: 'Help',
};

const slug = entry.id.replace(/\.mdx?$/, '');
const dir = slug.includes('/') ? slug.split('/')[0] : null;
const section = dir ? SECTIONS[dir] : null;

// Link the section label at the first page the sidebar lists under it, so the
// crumb goes somewhere real rather than to a directory with no index.
const group = section
  ? sidebar.find((item) => item.type === 'group' && item.label === section)
  : undefined;
const sectionHref =
  group && group.type === 'group' && group.entries[0]?.type === 'link'
    ? group.entries[0].href
    : null;
---

{
  section && (
    <nav class="u-crumbs not-content" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href={`${base}/`}>Universe Wallet</a>
        </li>
        <li>
          {sectionHref ? <a href={sectionHref}>{section}</a> : <span>{section}</span>}
        </li>
      </ol>
    </nav>
  )
}

<Default />

<style>
  .u-crumbs {
    margin-bottom: 0.55rem;
  }
  .u-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
  .u-crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--sl-color-gray-4);
  }
  .u-crumbs a {
    color: var(--sl-color-gray-3);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .u-crumbs a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
