---
// ShotSequence: several verified captures presented as an ordered walk, for
// multi-screen tasks. Each step keeps its own caption; nothing here implies
// more steps than the captures prove.
import ProductShot from './ProductShot.astro';
import { getCapture } from '../../lib/captures';

interface Props {
  steps: { captureId: string; label: string }[];
  danger?: boolean;
}
const { steps, danger = false } = Astro.props;
---

<ol class="u-sequence">
  {
    steps.map((step) => (
      <li>
        <p class="u-sequence__label">{step.label}</p>
        <ProductShot captureId={step.captureId} compact danger={danger} />
      </li>
    ))
  }
</ol>

<style>
  .u-sequence {
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1.25rem;
  }
  .u-sequence li {
    border: 1px solid var(--u-hairline);
    border-radius: var(--u-radius-lg);
    background: var(--u-surface);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
  }
  .u-sequence__label {
    font-weight: 700;
    font-size: 0.92rem;
    margin: 0 0 0.5rem;
  }
  .u-sequence :global(.u-shot) {
    margin: auto auto 0 auto;
    max-inline-size: 220px;
  }
</style>
