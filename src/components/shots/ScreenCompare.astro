---
// ScreenCompare: two verified captures side by side, for release or theme
// comparison. Each side keeps its own caption and release badge, so a reader
// never loses track of which pixels belong to which build.
import ProductShot from './ProductShot.astro';
import ReleaseBadge from '../badges/ReleaseBadge.astro';
import { getCapture } from '../../lib/captures';

interface Props {
  leftCaptureId: string;
  rightCaptureId: string;
  leftLabel?: string;
  rightLabel?: string;
}
const { leftCaptureId, rightCaptureId, leftLabel, rightLabel } = Astro.props;
const left = getCapture(leftCaptureId);
const right = getCapture(rightCaptureId);
---

<div class="u-compare">
  <div class="u-compare__pane">
    {leftLabel && <p class="u-compare__label">{leftLabel}</p>}
    <ReleaseBadge releaseId={left.releaseId} />
    <ProductShot captureId={leftCaptureId} compact />
  </div>
  <div class="u-compare__pane">
    {rightLabel && <p class="u-compare__label">{rightLabel}</p>}
    <ReleaseBadge releaseId={right.releaseId} />
    <ProductShot captureId={rightCaptureId} compact />
  </div>
</div>

<style>
  .u-compare {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  @media (min-width: 48rem) {
    .u-compare {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .u-compare__pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .u-compare__pane :global(.u-shot) {
    margin: 0.75rem auto 0;
    max-inline-size: 260px;
  }
  .u-compare__label {
    font-weight: 700;
    margin: 0 0 0.4rem;
  }
</style>
